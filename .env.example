# JARVIS OS Environment Configuration
APP_NAME=JARVIS OS
APP_ENV=development
LOG_LEVEL=INFO

# API Server Settings
HOST=127.0.0.1
PORT=8000
SECRET_KEY=change-this-super-secret-key-in-production

# Security & Encryption
VAULT_MASTER_KEY=jarvis-os-default-master-key-change-me
SENSITIVE_ACTION_CONFIRMATION_REQUIRED=true

# Databases & Vector Store
DATABASE_URL=sqlite:///./jarvis_data.db
CHROMADB_PATH=./chroma_db

# AI Provider Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o

# Voice Settings
STT_MODEL=whisper-base
TTS_ENGINE=edge-tts
WAKE_WORD=Hey Jarvis
